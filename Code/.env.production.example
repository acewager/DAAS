# Production environment template (M10) — copy to .env.production and fill in.
# NEVER commit .env.production.

# --- Core ---
SECRET_KEY=change-me-to-a-long-random-50-plus-characters-unique
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.production
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Platform domain (desktop subdomains + certificates) ---
TRAEFIK_DOMAIN=platform.example.com
ACME_EMAIL=admin@example.com

# --- PostgreSQL ---
POSTGRES_DB=dcp
POSTGRES_USER=dcp
POSTGRES_PASSWORD=change-me-strong-password

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Sessions ---
SESSION_COOKIE_AGE=604800

# --- Desktop defaults ---
DEFAULT_CPU_LIMIT=2
DEFAULT_MEMORY_LIMIT=2G
DEFAULT_AUTO_STOP=60

# --- Logging ---
LOG_LEVEL=INFO

# --- Monitoring (optional) ---
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
