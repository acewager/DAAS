# Copy to .env and adjust as needed. Never commit the real .env file.
# See 06_Backend_Architecture.md Section 9 and 12_Deployment.md Section 9.

# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1,app.localhost,api.localhost,backend

# --- PostgreSQL ---
POSTGRES_DB=dcp
POSTGRES_USER=dcp
POSTGRES_PASSWORD=dcp
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://app.localhost,http://localhost:5173
AUTH_LOGIN_RATE_LIMIT=10/hour
AUTH_REGISTER_RATE_LIMIT=5/hour
ANON_RATE_LIMIT=100/hour

# --- Docker / Traefik ---
DOCKER_HOST=unix:///var/run/docker.sock
TRAEFIK_DOMAIN=localhost
DEFAULT_CPU_LIMIT=2
DEFAULT_MEMORY_LIMIT=2G
DEFAULT_AUTO_STOP=60

# --- Logging ---
LOG_LEVEL=INFO

# --- Frontend (build-time) ---
VITE_API_URL=/api/v1
